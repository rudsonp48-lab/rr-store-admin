rules_version = '2';

// ATENÇÃO: troque SEU_EMAIL@exemplo.com pelo e-mail do administrador antes de publicar.
// Publique em: Firebase Console > Firestore Database > Regras.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['SEU_EMAIL@exemplo.com'];
    }

    // Catálogo, fretes e banners: a loja lê; só o admin escreve.
    match /rr_store_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: a loja cria (sem dados de cartão); só o admin lê/atualiza/exclui.
    match /rr_store_orders/{orderId} {
      allow create: if request.resource.data.status == 'aguardando_confirmacao_whatsapp'
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50
        && request.resource.data.customer is map
        && !('cvvCartao' in request.resource.data.customer)
        && !('numeroCartaoSimulado' in request.resource.data.customer);
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
