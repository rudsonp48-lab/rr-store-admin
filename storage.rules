rules_version = '2';

// ATENÇÃO: troque SEU_EMAIL@exemplo.com pelo e-mail do administrador antes de publicar.
// Publique em: Firebase Console > Storage > Regras.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['SEU_EMAIL@exemplo.com'];
    }

    match /{folder}/{file} {
      allow read: if true;
      allow write: if isAdmin()
        && folder in ['banners', 'produtos']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
